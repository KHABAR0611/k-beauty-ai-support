# Compose reads this file; Python CLI reads exported environment variables.
QDRANT_API_KEY=local-development-change-me
QDRANT_HTTP_PORT=6333
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION_ALIAS=kbeauty_active
# Model ID/revision/dimension are immutable in retrieval/bge-m3.lock.json.
# Do not place real keys in Git or command-line arguments.
# Python API reads exported variables; it does not auto-load this file.
API_ACCESS_KEY=replace-with-private-local-access-key
LLM_PROVIDER=disabled
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:0.6b
# Full 64-character local digest from /api/tags; required when provider=ollama.
LLM_MODEL_DIGEST=
LLM_TIMEOUT_SECONDS=25
REQUEST_TIMEOUT_SECONDS=40
API_RATE_PER_MINUTE=30
RERANK_ENABLED=false
